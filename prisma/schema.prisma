// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User & Auth ────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  failedLogins          Int       @default(0)
  lockedUntil           DateTime?
  lastFailedAt          DateTime?
  lastDashboardViewedAt DateTime?

  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  rules                 Rule[]
  sessions              Session[]
  chatSessions          ChatSession[]
  backups               Backup[]
  settings              UserSettings?
  auditLogs             AuditLog[]
  recurringTransactions RecurringTransaction[]
  resetTokens           PasswordResetToken[]
  bankConnections       BankConnection[]
  insurancePolicies     InsurancePolicy[]
  estateDocuments       EstateDocument[]
  incomeSources         IncomeSource[]
  dependents            Dependent[]
  householdObligations  HouseholdObligation[]
  plannedExpenses       PlannedExpense[]
  financialGoals        FinancialGoal[]
  vehicles              Vehicle[]
  homeAssets            HomeAsset[]
  homeMaintenanceTasks  HomeMaintenanceTask[]
  emergencyPreparednessItems EmergencyPreparednessItem[]
  householdTransitionPlans HouseholdTransitionPlan[]
  householdTransitionContacts HouseholdTransitionContact[]
  trustedAccessInvitations TrustedAccessInvitation[] @relation("TrustedAccessOwner")
  trustedAccessGrantsOwned TrustedAccessGrant[] @relation("TrustedAccessGrantOwner")
  trustedAccessGrantsReceived TrustedAccessGrant[] @relation("TrustedAccessRecipient")
  handoffSummaries       HandoffSummary[]
  ownedHousehold         Household? @relation("HouseholdOwner")
  householdMembership    HouseholdMembership?
  capabilitySettings    CapabilitySetting[]
  recommendations       Recommendation[]
  advisorInsights       AdvisorInsight[]
}

enum HouseholdTransitionContactRole {
  INCAPACITY_AGENT
  POTENTIAL_EXECUTOR
  SURVIVING_HOUSEHOLD_CONTACT
}

enum TrustedAccessInvitationStatus {
  PENDING
  APPROVED
  REVOKED
  EXPIRED
}

enum HouseholdMembershipRole {
  MEMBER
  SURVIVING_HOUSEHOLD_LEAD
}

/// A Wardkeep coordination household. It does not merge personal financial records or confer authority.
model Household {
  id          String                @id @default(uuid())
  ownerUserId String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  owner       User                  @relation("HouseholdOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     HouseholdMembership[]
  invitations TrustedAccessInvitation[] @relation("HouseholdInvitations")
}

model HouseholdMembership {
  id          String                  @id @default(uuid())
  householdId String
  userId      String                  @unique
  role        HouseholdMembershipRole @default(MEMBER)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

/// An owner-created, recipient-approved access request. It grants no data by itself.
model TrustedAccessInvitation {
  id             String                       @id @default(uuid())
  ownerUserId    String
  recipientEmail String                       @db.VarChar(254)
  scopes         String[]
  tokenHash      String                       @unique @db.VarChar(64)
  householdId    String?
  status         TrustedAccessInvitationStatus @default(PENDING)
  expiresAt      DateTime
  approvedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                     @default(now())
  updatedAt      DateTime                     @updatedAt

  owner User @relation("TrustedAccessOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  household Household? @relation("HouseholdInvitations", fields: [householdId], references: [id], onDelete: SetNull)
  audits TrustedAccessAuditEvent[]

  @@index([ownerUserId, status])
  @@index([recipientEmail, status])
  @@index([householdId])
}

/// A least-privilege grant created only after an invitation is accepted.
model TrustedAccessGrant {
  id              String   @id @default(uuid())
  ownerUserId     String
  recipientUserId String
  scopes          String[]
  isActive        Boolean  @default(true)
  approvedAt      DateTime @default(now())
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner     User @relation("TrustedAccessGrantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  recipient User @relation("TrustedAccessRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  audits TrustedAccessAuditEvent[]

  @@unique([ownerUserId, recipientUserId])
  @@index([recipientUserId, isActive])
}

/// Append-only operational history for invitations and access grants.
model TrustedAccessAuditEvent {
  id           String   @id @default(uuid())
  invitationId String?
  grantId      String?
  actorUserId  String
  event        String   @db.VarChar(80)
  metadata     Json
  createdAt    DateTime @default(now())

  invitation TrustedAccessInvitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  grant      TrustedAccessGrant? @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([grantId, createdAt])
}

/// An immutable organizer snapshot released only by its owner to active, approved recipients.
model HandoffSummary {
  id        String   @id @default(uuid())
  userId    String
  payload   Json
  sharedAt  DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sharedAt, createdAt])
}

/// A planning reference only. This record does not grant authority or access.
model HouseholdTransitionContact {
  id        String                         @id @default(uuid())
  userId    String
  role      HouseholdTransitionContactRole
  name      String                         @db.VarChar(120)
  email     String?                        @db.VarChar(254)
  phone     String?                        @db.VarChar(40)
  notes     String?                        @db.VarChar(1000)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, role])
}

/// A household's explicit capability preference. Missing records inherit the
/// enabled-by-default state for registered core capabilities.
model CapabilitySetting {
  id           String   @id @default(uuid())
  userId       String
  capabilityId String   @db.VarChar(100)
  isEnabled    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capabilityId])
  @@index([userId, isEnabled])
}

// ─── Durable household actions ────────────────────────────────────────────────

enum RecommendationStatus {
  ACTIVE
  DISMISSED
  COMPLETED
  RESOLVED
}

model Recommendation {
  id                   String               @id @default(uuid())
  userId               String
  fingerprint          String               @db.VarChar(191)
  capabilityId         String               @db.VarChar(100)
  pillar               String               @db.VarChar(30)
  signalSummary        String               @db.VarChar(1000)
  action               String               @db.VarChar(240)
  actionHref           String               @db.VarChar(240)
  reasoning            String               @db.VarChar(1500)
  severity             String               @default("low") @db.VarChar(20)
  priority             String               @db.VarChar(20)
  priorityScore        Int
  priorityExplanation  String               @default("") @db.VarChar(500)
  confidence           Decimal              @default(1.00) @db.Decimal(3, 2)
  supportingData       String[]             @default([])
  relevanceDate        DateTime?
  assumptions          String               @db.VarChar(1500)
  impactPreview        String               @default("Wardkeep cannot reliably project a numeric score change from this action yet.") @db.VarChar(1500)
  projectedPillarDelta Int?
  estimatedAmount      Decimal?              @db.Decimal(19, 4)
  estimatedMonthlyAmount Decimal?            @db.Decimal(19, 4)
  estimatedAmountLabel String?               @db.VarChar(160)
  estimatedCompletionDays Int?
  status               RecommendationStatus @default(ACTIVE)
  dismissedAt          DateTime?
  completedAt          DateTime?
  scoreAtCompletion   Int?
  scoreRecordedAtCompletion DateTime?
  resolvedAt           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, status, priorityScore])
}

// A deterministic observation that combines signals from more than one capability.
model AdvisorInsight {
  id                 String   @id @default(uuid())
  userId             String
  fingerprint        String   @db.VarChar(191)
  summary            String   @db.VarChar(1500)
  action             String   @db.VarChar(240)
  actionHref         String   @db.VarChar(240)
  sourceCapabilities String[]
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, fingerprint, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  lastActive DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
}

// ─── Accounts ───────────────────────────────────────────────────────────────────

model Account {
  id             String      @id @default(uuid())
  userId         String
  name           String      @db.VarChar(100)
  type           AccountType
  currency       String      @default("USD") @db.VarChar(3)
  initialBalance Decimal     @db.Decimal(19, 4)
  creditLimit    Decimal?    @db.Decimal(19, 4)
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user                     User                   @relation(fields: [userId], references: [id])
  transactions             Transaction[]
  recurring                RecurringTransaction[]
  linkedBankAccounts       LinkedBankAccount[]
  debtProfile              DebtProfile?
  bundledInsurancePolicies InsurancePolicy[]      @relation("BundledInsurancePayments")

  @@unique([userId, name])
  @@index([userId, isArchived])
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  LOAN
  MORTGAGE
  HELOC
  CASH
  MANUAL
}

// ─── Household Protection ───────────────────────────────────────────────────────

enum InsurancePolicyType {
  AUTO
  HOME
  RENTERS
  HEALTH
  LIFE
  DISABILITY
  UMBRELLA
  OTHER
}

enum InsurancePremiumFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum InsurancePaymentArrangement {
  SEPARATE
  MORTGAGE_ESCROW
  LOAN_OR_LEASE
  OTHER_BUNDLED
}

model InsurancePolicy {
  id                   String                      @id @default(uuid())
  userId               String
  type                 InsurancePolicyType
  provider             String                      @db.VarChar(160)
  nickname             String?                     @db.VarChar(100)
  premium              Decimal?                    @db.Decimal(19, 4)
  premiumFrequency     InsurancePremiumFrequency   @default(MONTHLY)
  paymentArrangement   InsurancePaymentArrangement @default(SEPARATE)
  paymentAccountId     String?
  propertyTaxEscrow    Decimal?                    @db.Decimal(19, 4)
  propertyTaxFrequency InsurancePremiumFrequency?
  deductible           Decimal?                    @db.Decimal(19, 4)
  coverageAmount       Decimal?                    @db.Decimal(19, 4)
  coverageTargetAmount Decimal?                    @db.Decimal(19, 4)
  renewalDate          DateTime?                   @db.Date
  isActive             Boolean                     @default(true)
  notes                String?                     @db.VarChar(1000)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount Account? @relation("BundledInsurancePayments", fields: [paymentAccountId], references: [id], onDelete: SetNull)

  @@index([userId, isActive])
  @@index([userId, renewalDate])
  @@index([paymentAccountId])
}

enum EstateDocumentType {
  WILL
  TRUST
  FINANCIAL_POWER_OF_ATTORNEY
  HEALTHCARE_DIRECTIVE
  BENEFICIARY_REVIEW
  OTHER
}

/// A record that a household has identified a planning document. Wardkeep stores
/// the review reminder, not document contents or legal advice about its adequacy.
model EstateDocument {
  id         String             @id @default(uuid())
  userId     String
  type       EstateDocumentType
  title      String?            @db.VarChar(100)
  reviewDate DateTime?          @db.Date
  isActive   Boolean            @default(true)
  notes      String?            @db.VarChar(1000)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, reviewDate])
}

enum IncomeFrequency {
  WEEKLY
  BIWEEKLY
  SEMI_MONTHLY
  MONTHLY
  CUSTOM
}

enum IncomeSourceKind {
  EMPLOYMENT
  SELF_EMPLOYMENT
  BENEFIT
  SUPPORT
  OTHER
}

enum EmploymentPayType {
  SALARY
  HOURLY
  OTHER
}

/// Household-entered income planning context, not evidence of employment or payment continuity.
model IncomeSource {
  id                String           @id @default(uuid())
  userId            String
  name              String           @db.VarChar(100)
  kind              IncomeSourceKind @default(EMPLOYMENT)
  frequency         IncomeFrequency
  expectedNetAmount Decimal?         @db.Decimal(19, 4)
  employmentPayType EmploymentPayType?
  hourlyRate        Decimal?         @db.Decimal(19, 4)
  typicalHoursPerPayPeriod Decimal?  @db.Decimal(9, 2)
  nextExpectedDate  DateTime?        @db.Date
  reviewDate        DateTime?        @db.Date
  isActive          Boolean          @default(true)
  notes             String?          @db.VarChar(1000)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, reviewDate])
}

enum DependentRelationship {
  CHILD
  ADULT
  OTHER
}

/// Minimal household planning context; Wardkeep does not request identities or assess care needs.
model Dependent {
  id           String                @id @default(uuid())
  userId       String
  label        String?               @db.VarChar(100)
  relationship DependentRelationship @default(OTHER)
  reviewDate   DateTime?             @db.Date
  isActive     Boolean               @default(true)
  notes        String?               @db.VarChar(1000)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, reviewDate])
}

/// A household-entered recurring commitment not necessarily represented in
/// transaction history. Variable amounts remain labeled as estimates.
model HouseholdObligation {
  id            String   @id @default(uuid())
  userId        String
  name          String   @db.VarChar(100)
  monthlyAmount Decimal  @db.Decimal(19, 4)
  isVariable    Boolean  @default(false)
  reviewDate    DateTime? @db.Date
  isActive      Boolean  @default(true)
  notes         String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, reviewDate])
}

model PlannedExpense {
  id           String    @id @default(uuid())
  userId       String
  name         String    @db.VarChar(100)
  amount       Decimal?  @db.Decimal(19, 4)
  fundedAmount Decimal?  @db.Decimal(19, 4)
  dueDate      DateTime? @db.Date
  isActive     Boolean   @default(true)
  notes        String?   @db.VarChar(1000)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, dueDate])
}

/// A household-entered financial goal. Progress is recorded by the household;
/// Wardkeep does not infer it from account balances or transactions.
model FinancialGoal {
  id            String   @id @default(uuid())
  userId        String
  name          String   @db.VarChar(100)
  targetAmount  Decimal? @db.Decimal(19, 4)
  savedAmount   Decimal  @default(0) @db.Decimal(19, 4)
  targetDate    DateTime? @db.Date
  isActive      Boolean  @default(true)
  notes         String?  @db.VarChar(1000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([userId, targetDate])
}

/// A vehicle the household has chosen to track. Mileage and maintenance are
/// recorded by the household; Wardkeep never infers them from transactions.
model Vehicle {
  id           String    @id @default(uuid())
  userId       String
  kind         VehicleKind @default(AUTOMOBILE)
  ownership    VehicleOwnership @default(OWNED)
  nickname     String?   @db.VarChar(100)
  make         String    @db.VarChar(80)
  model        String    @db.VarChar(80)
  year         Int?
  vin          String?   @db.VarChar(17)
  mileage      Int?
  loanBalance  Decimal?  @db.Decimal(19, 4)
  leasePayment Decimal?  @db.Decimal(19, 4)
  leaseEndDate DateTime? @db.Date
  leaseMileageAllowance Int?
  estimatedValue Decimal? @db.Decimal(19, 4)
  valuationSource String? @db.VarChar(80)
  valuedAt     DateTime? @db.Date
  isActive     Boolean   @default(true)
  notes        String?   @db.VarChar(1000)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenance VehicleMaintenance[]

  @@index([userId, isActive])
}

enum VehicleKind {
  AUTOMOBILE
  MOTORCYCLE
  RV
  BOAT
  TRAILER
  ATV
  OTHER
}

enum VehicleOwnership {
  OWNED
  FINANCED
  LEASED
  OTHER
}

/// A recorded or planned maintenance item for a household vehicle. A due date
/// or due mileage is an explicit reminder, not an assertion that work occurred.
model VehicleMaintenance {
  id          String    @id @default(uuid())
  vehicleId   String
  name        String    @db.VarChar(120)
  dueDate     DateTime? @db.Date
  dueMileage  Int?
  completedAt DateTime? @db.Date
  completedMileage Int?
  estimatedCost Decimal? @db.Decimal(19, 4)
  actualCost   Decimal? @db.Decimal(19, 4)
  paidAt       DateTime? @db.Date
  notes       String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, dueDate])
  @@index([vehicleId, completedAt])
}

/// A household appliance or maintained home component. Expected lifespan and
/// replacement cost are household-entered planning values, not predictions.
model HomeAsset {
  id                   String    @id @default(uuid())
  userId               String
  name                 String    @db.VarChar(120)
  type                 String    @db.VarChar(80)
  installedAt          DateTime? @db.Date
  expectedLifespanYears Int?
  replacementCost      Decimal?  @db.Decimal(19, 4)
  isActive             Boolean   @default(true)
  notes                String?   @db.VarChar(1000)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks HomeMaintenanceTask[]

  @@index([userId, isActive])
}

/// A recorded home-maintenance reminder. A due date does not confirm that the
/// service happened; completion is recorded separately by the household.
model HomeMaintenanceTask {
  id          String    @id @default(uuid())
  homeAssetId String?
  userId      String
  name        String    @db.VarChar(120)
  dueDate     DateTime? @db.Date
  completedAt DateTime? @db.Date
  estimatedCost Decimal? @db.Decimal(19, 4)
  actualCost  Decimal? @db.Decimal(19, 4)
  notes       String? @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeAsset HomeAsset? @relation(fields: [homeAssetId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([homeAssetId])
}

enum EmergencyPreparednessCategory {
  FOOD
  WATER
  FIRST_AID
  IMPORTANT_DOCUMENTS
  EVACUATION_PLAN
  OTHER
}

/// A household-entered preparedness checklist item. Completion indicates only
/// that the household recorded it as complete; it is not a safety certification.
model EmergencyPreparednessItem {
  id          String                       @id @default(uuid())
  userId      String
  category    EmergencyPreparednessCategory
  name        String                       @db.VarChar(120)
  isComplete  Boolean                      @default(false)
  reviewDate  DateTime?                    @db.Date
  notes       String?                      @db.VarChar(1000)
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, reviewDate])
}

enum HouseholdTransitionMode {
  INCAPACITY_CONTINUITY
  AFTER_DEATH_SETTLEMENT
}

/// A neutral organizer for household continuity planning. This record does not
/// establish incapacity/death, prove legal authority, or grant anyone access.
model HouseholdTransitionPlan {
  id          String                  @id @default(uuid())
  userId      String
  mode        HouseholdTransitionMode
  title       String                  @db.VarChar(120)
  reviewDate  DateTime?               @db.Date
  isActive    Boolean                 @default(true)
  notes       String?                 @db.VarChar(2000)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, mode, isActive])
}

// ─── Transactions ───────────────────────────────────────────────────────────────

model Transaction {
  id               String            @id @default(uuid())
  userId           String
  accountId        String
  categoryId       String?
  date             DateTime          @db.Date
  amount           Decimal           @db.Decimal(19, 4)
  type             TransactionType
  status           TransactionStatus @default(POSTED)
  merchant         String?           @db.VarChar(100)
  description      String?           @db.VarChar(500)
  notes            String?           @db.VarChar(1000)
  isReconciliation Boolean           @default(false)
  isReviewed       Boolean           @default(true)
  refundForTransactionId String?
  refundMatchedAt  DateTime?
  aiCategorized    Boolean           @default(false)
  aiConfidence     Decimal?          @db.Decimal(3, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  account  Account          @relation(fields: [accountId], references: [id])
  category Category?        @relation(fields: [categoryId], references: [id])
  tags     TransactionTag[]

  @@index([userId, accountId, date])
  @@index([userId, categoryId])
  @@index([userId, merchant])
  @@index([userId, isReviewed, date])
  @@index([userId, refundForTransactionId])
  @@index([accountId, date, amount, merchant])
}

enum TransactionType {
  DEBIT
  CREDIT
  TRANSFER
}

enum TransactionStatus {
  PENDING
  POSTED
  CLEARED
}

model TransactionTag {
  id            String @id @default(uuid())
  transactionId String
  tag           String @db.VarChar(50)

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, tag])
  @@index([tag])
}

// ─── Categories ─────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(uuid())
  userId    String
  parentId  String?
  name      String   @db.VarChar(50)
  icon      String?  @db.VarChar(50)
  color     String?  @db.VarChar(7)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User               @relation(fields: [userId], references: [id])
  parent       Category?          @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     Category[]         @relation("CategoryHierarchy")
  transactions Transaction[]
  allocations  BudgetAllocation[]

  @@unique([userId, parentId, name])
  @@index([userId])
}

// ─── Budgets ────────────────────────────────────────────────────────────────────

model Budget {
  id        String   @id @default(uuid())
  userId    String
  month     DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id])
  allocations BudgetAllocation[]

  @@unique([userId, month])
}

model BudgetAllocation {
  id         String  @id @default(uuid())
  budgetId   String
  categoryId String
  amount     Decimal @db.Decimal(19, 4)
  rolloverEnabled Boolean @default(false)
  rolloverAmount  Decimal @default(0) @db.Decimal(19, 4)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([budgetId, categoryId])
}

// ─── Rules ──────────────────────────────────────────────────────────────────────

model Rule {
  id        String    @id @default(uuid())
  userId    String
  name      String    @db.VarChar(100)
  priority  Int
  isActive  Boolean   @default(true)
  logic     RuleLogic @default(ALL)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user       User            @relation(fields: [userId], references: [id])
  conditions RuleCondition[]
  actions    RuleAction[]

  @@index([userId, isActive, priority])
}

enum RuleLogic {
  ALL
  ANY
}

model RuleCondition {
  id       String             @id @default(uuid())
  ruleId   String
  field    RuleConditionField
  operator RuleOperator
  value    String             @db.VarChar(500)

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

enum RuleConditionField {
  MERCHANT
  AMOUNT
  DESCRIPTION
}

enum RuleOperator {
  CONTAINS
  EQUALS
  STARTS_WITH
  REGEX
  GREATER_THAN
  LESS_THAN
  BETWEEN
}

model RuleAction {
  id     String         @id @default(uuid())
  ruleId String
  type   RuleActionType
  value  String         @db.VarChar(500)

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

enum RuleActionType {
  SET_CATEGORY
  ADD_TAG
  SET_MERCHANT
  ADD_NOTE
}

// ─── Recurring Transactions ─────────────────────────────────────────────────────

model RecurringTransaction {
  id             String              @id @default(uuid())
  userId         String
  accountId      String
  merchant       String              @db.VarChar(100)
  expectedAmount Decimal             @db.Decimal(19, 4)
  frequency      RecurrenceFrequency
  nextExpected   DateTime            @db.Date
  isConfirmed    Boolean             @default(false)
  isDismissed    Boolean             @default(false)
  isActive       Boolean             @default(true)
  isSubscription Boolean             @default(false)
  cancelledAt    DateTime?           @db.Date
  createdAt      DateTime            @default(now())

  user    User    @relation(fields: [userId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@index([userId, isActive])
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

// ─── AI Chat ────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ChatMessage {
  id           String   @id @default(uuid())
  sessionId    String
  role         String
  content      String   @db.Text
  verifiedData Json?
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── User Settings ──────────────────────────────────────────────────────────────

model UserSettings {
  id               String          @id @default(uuid())
  userId           String          @unique
  aiPrivacyMode    AIPrivacyMode   @default(LOCAL)
  openaiKey        String?
  anthropicKey     String?
  backupSchedule   BackupSchedule?
  backupPassphrase String?
  backupRetention  Int             @default(5)
  sessionTimeout   Int             @default(30)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum AIPrivacyMode {
  LOCAL
  HYBRID
  CLOUD
}

enum BackupSchedule {
  DAILY
  WEEKLY
  MONTHLY
}

// ─── Backups ────────────────────────────────────────────────────────────────────

model Backup {
  id        String   @id @default(uuid())
  userId    String
  filename  String
  size      BigInt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ─── Audit Logs ─────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   @db.VarChar(100)
  details   Json?
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ─── Debt Profiles ──────────────────────────────────────────────────────────────

model DebtProfile {
  id             String   @id @default(uuid())
  userId         String
  accountId      String   @unique
  apr            Decimal  @db.Decimal(5, 4) // 0.0000 to 1.0000 (0%–100%)
  minimumPayment Decimal  @db.Decimal(19, 4)
  assetValue     Decimal? @db.Decimal(19, 4) // Linked asset value (home, vehicle) for secured debts
  priority       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Saved Payoff Plans ─────────────────────────────────────────────────────────

model SavedPayoffPlan {
  id                  String   @id @default(uuid())
  userId              String
  name                String   @db.VarChar(100)
  accountIds          String[] // Array of account IDs included in this plan
  strategy            String   @db.VarChar(20) // snowball, avalanche, custom
  totalMonthlyPayment Decimal  @db.Decimal(19, 4)
  totalInterest       Decimal  @db.Decimal(19, 4)
  totalMonths         Int
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── AI Corrections ─────────────────────────────────────────────────────────────

model AICorrection {
  id         String   @id @default(uuid())
  userId     String
  merchant   String   @db.VarChar(100)
  categoryId String
  createdAt  DateTime @default(now())

  @@unique([userId, merchant])
  @@index([userId, merchant])
}

// ─── Bank Connections (SimpleFIN/Plaid) ─────────────────────────────────────────

model BankConnection {
  id              String                 @id @default(uuid())
  userId          String
  provider        BankConnectionProvider
  institutionName String                 @db.VarChar(200)
  accessToken     String                 @db.VarChar(1000) // Encrypted at application layer
  status          BankConnectionStatus   @default(ACTIVE)
  lastSyncAt      DateTime?
  lastError       String?                @db.VarChar(500)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user           User                @relation(fields: [userId], references: [id])
  linkedAccounts LinkedBankAccount[]

  @@index([userId, status])
}

model LinkedBankAccount {
  id           String   @id @default(uuid())
  connectionId String
  accountId    String? // Links to the local Account, null if not yet linked
  externalId   String   @db.VarChar(200) // External account ID from provider
  externalName String   @db.VarChar(200)
  externalType String   @db.VarChar(50)
  isEnabled    Boolean  @default(true) // Whether to sync transactions for this account
  createdAt    DateTime @default(now())

  connection BankConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  account    Account?       @relation(fields: [accountId], references: [id])

  @@unique([connectionId, externalId])
  @@index([accountId])
}

enum BankConnectionProvider {
  SIMPLEFIN
  PLAID
}

enum BankConnectionStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

// ─── Readiness Engine ───────────────────────────────────────────────────────────

model ReadinessSnapshot {
  id          String   @id @default(uuid())
  userId      String
  overall     Int
  protection  Int
  provision   Int
  preparation Int
  prosperity  Int
  peace       Int
  netWorth    Decimal? @db.Decimal(19, 4)
  recordedAt  DateTime @default(now()) @db.Date
  modelVersion Int    @default(1)

  signals ReadinessSignal[]
  observations ReadinessObservation[]
  changes ReadinessScoreChange[]

  @@unique([userId, recordedAt, modelVersion])
  @@index([userId, modelVersion, recordedAt])
}

/// Raw, household-scoped facts published by capabilities for a daily readiness snapshot.
model ReadinessObservation {
  id           String   @id @default(uuid())
  userId       String
  capabilityId String   @db.VarChar(100)
  fact         String   @db.VarChar(240)
  value        Json
  confidence   Decimal  @db.Decimal(3, 2)
  observedAt   DateTime
  snapshotId   String?
  createdAt    DateTime @default(now())

  snapshot ReadinessSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  signals ReadinessSignal[] @relation("SignalObservation")

  @@index([userId, capabilityId, observedAt])
  @@index([snapshotId])
}

model ReadinessSignal {
  id           String              @id @default(uuid())
  userId       String
  capabilityId String              @db.VarChar(50)
  type         SignalType
  magnitude    Int // -10 to +10
  pillar       ReadinessPillarEnum
  summary      String              @db.VarChar(500)
  weight       Decimal             @default(1.0) @db.Decimal(3, 2)
  expiresAt    DateTime?
  createdAt    DateTime            @default(now())
  snapshotId   String?

  snapshot ReadinessSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  observationId String?
  observation ReadinessObservation? @relation("SignalObservation", fields: [observationId], references: [id], onDelete: SetNull)

  @@index([userId, pillar])
  @@index([userId, createdAt])
  @@index([snapshotId])
  @@index([observationId])
}

/// A durable, deterministic explanation of how a daily readiness score changed.
model ReadinessScoreChange {
  id       String              @id @default(uuid())
  snapshotId String
  pillar   ReadinessPillarEnum
  previous Int
  current  Int
  delta    Int
  reason   String              @db.VarChar(1000)
  evidence Json
  createdAt DateTime           @default(now())

  snapshot ReadinessSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, pillar])
  @@index([snapshotId])
}

enum SignalType {
  RISK
  OPPORTUNITY
  MILESTONE
  WARNING
  POSITIVE
}

enum ReadinessPillarEnum {
  PROTECTION
  PROVISION
  PREPARATION
  PROSPERITY
  PEACE
}

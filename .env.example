# =============================================================================
# Wardkeep Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Generate a unique ENCRYPTION_KEY before first run:
#   openssl rand -hex 32
# =============================================================================

# ─── Security ────────────────────────────────────────────────────────────────
# REQUIRED: Set a unique 32+ character hex string. The app will refuse to start
# with the default value in production.
ENCRYPTION_KEY=change-me-in-production

# Session inactivity timeout in minutes (default: 30)
SESSION_TIMEOUT=30

# ─── Database ────────────────────────────────────────────────────────────────
# Must match docker-compose postgres service credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=wardkeep
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wardkeep?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── API Server ──────────────────────────────────────────────────────────────
PORT=4000

# Comma-separated browser origins permitted to call the API. Change this when
# hosting the web UI on a domain or a non-localhost address.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required only when this deployment initiates a remote-backup pairing. Use its
# externally reachable HTTPS origin (no path, query, credentials, or trailing route).
# WARDKEEP_PUBLIC_URL=https://wardkeep.example

# Optional override for opaque remote-backup blob storage. Docker Compose sets
# this beneath its persistent backups volume by default.
# WARDKEEP_REMOTE_BACKUP_DIR=/data/backups/remote-peers

# ─── Port (for docker-compose.prod.yml) ──────────────────────────────────────
WEB_PORT=3000

# ─── AI Configuration ────────────────────────────────────────────────────────
# Modes: LOCAL (Ollama only), HYBRID (sensitive local, general cloud), CLOUD (all cloud).
# For Docker Compose, LOCAL requires: docker compose --profile ai up -d
# AI mode is also configurable per-user in the Settings page
AI_PRIVACY_MODE=LOCAL
OLLAMA_URL=http://localhost:11434

# Optional UTC cron schedule for persisted deterministic daily advisor briefs.
# Defaults to 03:15 UTC, after the 03:00 readiness snapshot. Restart the worker
# after changing it. Example: 30 6 * * * for 06:30 UTC.
# WARDKEEP_DAILY_BRIEF_CRON=15 3 * * *

# Cloud AI keys (optional — can also be set per-user in Settings page)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Hardware Requirements ───────────────────────────────────────────────────
# Without local AI: 2 GB RAM, 2 CPU cores, 10 GB storage
# With local AI (Ollama): 8 GB RAM, 4 CPU cores, 20 GB storage

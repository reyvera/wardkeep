{
  "enabled": false,
  "name": "Close GitHub Issue on Task Complete",
  "description": "Disabled: task completion must use an explicit issue reference and remote-verified commit, never title or keyword matching.",
  "version": "1.0.0",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Disabled. Use an explicit #issue reference and verify the commit is on the remote before changing issue status or closing an issue."
  }
}

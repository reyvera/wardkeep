{
  "enabled": false,
  "name": "Mark GitHub Issue In Progress",
  "description": "Disabled: work status must be set against an explicitly referenced issue, never a title or keyword match.",
  "version": "1.0.0",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Disabled. Set status only on an explicitly referenced issue, and keep the Project status field aligned with its status label."
  }
}

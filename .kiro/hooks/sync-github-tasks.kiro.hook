{
  "enabled": true,
  "name": "Sync Tasks to GitHub on Stop",
  "description": "After agent execution, reports only explicit Wardkeep issue-closing references from the latest commit. It never closes issues automatically.",
  "version": "1.0.0",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "bash scripts/sync-tasks-to-github.sh"
  }
}
